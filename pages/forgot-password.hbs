<section class="login-page"><div class="login-copy"><h1 class="display">Reset password.</h1><p class="lead">Enter your account email and we will send reset instructions.</p><form data-portal-forgot class="login-form cut-panel"><p data-portal-status hidden role="status"></p><label for="forgot-email">Email</label><input id="forgot-email" name="email" type="email" autocomplete="email" required placeholder="you@example.com"><button class="button" type="submit">Send reset link</button><p style="margin-top:0.75rem;"><a href="./login.html">Back to sign in</a></p></form><form data-portal-reset hidden class="login-form cut-panel"><p data-portal-status hidden role="status"></p><input type="hidden" name="token"><label for="reset-pass">New password (min 8 chars)</label><input id="reset-pass" name="password" type="password" minlength="8" autocomplete="new-password" required><label for="reset-confirm">Confirm password</label><input id="reset-confirm" name="password_confirmation" type="password" minlength="8" autocomplete="new-password" required><button class="button" type="submit">Set new password</button></form></div><div class="art">{{> brand-x}}</div></section>