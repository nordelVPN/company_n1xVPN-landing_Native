<!doctype html><html lang="{{lang}}" data-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title data-i18n="{{titleKey}}">{{title}}</title><meta name="description" content="{{description}}" data-i18n-content="{{descriptionKey}}">{{#if canonical}}<link rel="canonical" href="{{canonical}}">{{/if}}<link rel="icon" href="assets/favicon.svg" type="image/svg+xml"></head><body><a class="skip-link" href="#main-content"><span data-i18n="skip" >Skip to content</span></a>{{> header}}<main id="main-content">{{{body}}}</main>{{> footer}}{{> wishlist}}</body></html>