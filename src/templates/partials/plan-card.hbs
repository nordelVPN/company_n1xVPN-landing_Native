<article class="plan-card cut-panel" data-plan="{{id}}"><h3 data-i18n="{{nameKey}}">{{name}}</h3><p class="price">{{price}}</p><p class="plan-devices" data-i18n="{{devicesKey}}">{{devices}}</p>{{#if note}}<p class="plan-note" data-i18n="{{noteKey}}">{{note}}</p>{{/if}}<button class="button" data-wishlist-open data-select-plan="{{id}}"><span data-i18n="{{buttonKey}}">{{button}}</span></button></article>